{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/product-list", "destination": "/product-list.html" },
      { "source": "/product-detail", "destination": "/product-detail.html" },
      { "source": "/cart", "destination": "/cart.html" },
      { "source": "/checkout", "destination": "/checkout.html" },
      { "source": "/orders", "destination": "/orders.html" },
      { "source": "/search", "destination": "/search.html" },
      { "source": "/login", "destination": "/login.html" },
      { "source": "/signup", "destination": "/signup.html" },
      { "source": "/signup-id", "destination": "/signup-id.html" },
      { "source": "/mypage", "destination": "/mypage.html" },
      { "source": "/admin/login", "destination": "/admin.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/dashboard", "destination": "/admin.html" },
      { "source": "/admin/users", "destination": "/admin.html" },
      { "source": "/admin/posts", "destination": "/admin.html" },
      { "source": "/admin/notices", "destination": "/admin.html" },
      { "source": "/admin/banners", "destination": "/admin.html" },
      { "source": "/admin/settings", "destination": "/admin.html" },
      { "source": "/admin/products", "destination": "/admin.html" },
      { "source": "/admin/categories", "destination": "/admin.html" },
      { "source": "/admin/inventory", "destination": "/admin.html" },
      { "source": "/admin/orders", "destination": "/admin.html" },
      { "source": "/admin/reviews", "destination": "/admin.html" },
      { "source": "/admin/stats", "destination": "/admin.html" }
    ]
  }
}
