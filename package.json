{
    "name":  "goodform",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 0.0.0.0",
                    "build":  "node scripts/write-firebase-config.mjs \u0026\u0026 vite build \u0026\u0026 node scripts/copy-static.mjs",
                    "preview":  "vite preview --host 0.0.0.0",
